{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/cadastro",
      "destination": "/index.html"
    },
    {
      "source": "/register",
      "destination": "/index.html"
    },
    {
      "source": "/auth/complete",
      "destination": "/api/auth_complete.py"
    }
  ],
  "functions": {
    "api/cime.py": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/auth_complete.py": {
      "memory": 512,
      "maxDuration": 30
    },
    "api/cime_health.py": {
      "memory": 256,
      "maxDuration": 10
    },
    "api/health.py": {
      "memory": 256,
      "maxDuration": 10
    },
    "api/qr.py": {
      "memory": 512,
      "maxDuration": 30
    },
    "api/auth/google/credential.py": {
      "memory": 1024,
      "maxDuration": 60
    }
  }
}
