{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/auth/google/credential",
      "destination": "/api/index.py?__cime_path=/api/auth/google/credential"
    },
    {
      "source": "/api/auth/status",
      "destination": "/api/index.py?__cime_path=/api/auth/status"
    },
    {
      "source": "/api/auth/login",
      "destination": "/api/index.py?__cime_path=/api/auth/login"
    },
    {
      "source": "/api/auth/register",
      "destination": "/api/index.py?__cime_path=/api/auth/register"
    },
    {
      "source": "/api/auth/logout",
      "destination": "/api/index.py?__cime_path=/api/auth/logout"
    },
    {
      "source": "/api/bootstrap",
      "destination": "/api/index.py?__cime_path=/api/bootstrap"
    },
    {
      "source": "/oauth/google/start",
      "destination": "/api/index.py?__cime_path=/oauth/google/start"
    },
    {
      "source": "/oauth/google/callback",
      "destination": "/api/index.py?__cime_path=/oauth/google/callback"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/cadastro",
      "destination": "/index.html"
    },
    {
      "source": "/register",
      "destination": "/index.html"
    },
    {
      "source": "/auth/complete",
      "destination": "/api/auth_complete.py"
    }
  ],
  "functions": {
    "api/cime.py": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/auth_complete.py": {
      "memory": 512,
      "maxDuration": 30
    },
    "api/cime_health.py": {
      "memory": 256,
      "maxDuration": 10
    },
    "api/health.py": {
      "memory": 256,
      "maxDuration": 10
    },
    "api/qr.py": {
      "memory": 512,
      "maxDuration": 30
    }
  }
}
