{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/cime.py": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/auth_complete.py": {
      "memory": 512,
      "maxDuration": 30
    },
    "api/cime_health.py": {
      "memory": 256,
      "maxDuration": 10
    },
    "api/health.py": {
      "memory": 256,
      "maxDuration": 10
    },
    "api/qr.py": {
      "memory": 512,
      "maxDuration": 30
    },
    "api/auth/google/credential.py": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/google_oauth_start.py": {
      "memory": 256,
      "maxDuration": 10
    },
    "api/google_oauth_callback.py": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/app",
      "destination": "/app.html",
      "permanent": false
    },
    {
      "source": "/app/",
      "destination": "/app.html",
      "permanent": false
    },
    {
      "source": "/login",
      "destination": "/index.html",
      "permanent": false
    },
    {
      "source": "/cadastro",
      "destination": "/index.html",
      "permanent": false
    },
    {
      "source": "/register",
      "destination": "/index.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/oauth/google/start",
      "destination": "/api/cime?__cime_path=/oauth/google/start"
    },
    {
      "source": "/oauth/google/callback",
      "destination": "/api/cime?__cime_path=/oauth/google/callback"
    },
    {
      "source": "/auth/complete",
      "destination": "/api/auth_complete.py"
    },
    {
      "source": "/api/health",
      "destination": "/api/health.py"
    },
    {
      "source": "/api/qr",
      "destination": "/api/qr.py"
    },
    {
      "source": "/api/cime_health",
      "destination": "/api/cime_health.py"
    },
    {
      "source": "/api/google_oauth_start",
      "destination": "/api/google_oauth_start.py"
    },
    {
      "source": "/api/google_oauth_callback",
      "destination": "/api/google_oauth_callback.py"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/cime?__cime_path=/api/:path*"
    }
  ]
}
