{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/cime-health",
      "destination": "/api/cime_health"
    },
    {
      "source": "/cime-api/:path*",
      "destination": "/api/cime?__cime_path=/api/:path*"
    },
    {
      "source": "/auth/complete",
      "destination": "/api/auth_complete.py"
    },
    {
      "source": "/api/health",
      "destination": "/api/health.py"
    },
    {
      "source": "/api/qr",
      "destination": "/api/qr.py"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.py?__cime_path=/api/:path*"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/cadastro",
      "destination": "/index.html"
    },
    {
      "source": "/register",
      "destination": "/index.html"
    },
    {
      "source": "/oauth/:path*",
      "destination": "/api/index.py?__cime_path=/oauth/:path*"
    }
  ],
  "functions": {
    "api/cime.py": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/auth_complete.py": {
      "memory": 512,
      "maxDuration": 30
    },
    "api/cime_health.py": {
      "memory": 256,
      "maxDuration": 10
    },
    "api/health.py": {
      "memory": 256,
      "maxDuration": 10
    },
    "api/qr.py": {
      "memory": 512,
      "maxDuration": 30
    }
  }
}
