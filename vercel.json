{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/cime-health",
      "destination": "/api/cime_health"
    },
    {
      "source": "/cime-api/:path*",
      "destination": "/api/cime?__cime_path=/api/:path*"
    },
    {
      "source": "/auth/complete",
      "destination": "/api/auth_complete.py"
    },
    {
      "source": "/api/health",
      "destination": "/api/health.py"
    },
    {
      "source": "/api/qr",
      "destination": "/api/qr.py"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.py?__cime_path=/api/:path*"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/cadastro",
      "destination": "/index.html"
    },
    {
      "source": "/register",
      "destination": "/index.html"
    },
    {
      "source": "/oauth/:path*",
      "destination": "/api/index.py?__cime_path=/oauth/:path*"
    }
  ]
}
