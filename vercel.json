{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/cime.py": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/auth_complete.py": {
      "memory": 512,
      "maxDuration": 30
    },
    "api/cime_health.py": {
      "memory": 256,
      "maxDuration": 10
    },
    "api/health.py": {
      "memory": 256,
      "maxDuration": 10
    },
    "api/qr.py": {
      "memory": 512,
      "maxDuration": 30
    },
    "api/auth/google/credential.py": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/login",
      "destination": "/index.html",
      "permanent": false
    },
    {
      "source": "/cadastro",
      "destination": "/index.html",
      "permanent": false
    },
    {
      "source": "/register",
      "destination": "/index.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/app",
      "destination": "/api/index.py?__cime_path=/app"
    },
    {
      "source": "/app/",
      "destination": "/api/index.py?__cime_path=/app"
    },
    {
      "source": "/auth/complete",
      "destination": "/api/index.py?__cime_path=/auth/complete"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.py?__cime_path=/api/:path*"
    },
    {
      "source": "/oauth/:path*",
      "destination": "/api/index.py?__cime_path=/oauth/:path*"
    }
  ]
}
