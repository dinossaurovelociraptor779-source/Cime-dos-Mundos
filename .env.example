# Copie este arquivo para .env e preencha apenas no ambiente local.
CIME_PORT=8770

# Segredo usado para assinar sessões e validar o estado OAuth.
# Gere um valor aleatório com pelo menos 64 caracteres.
# Nunca coloque o valor real neste arquivo versionado ou no GitHub.
# Na Vercel, configure CIME_SESSION_SECRET como variável Sensitive separada
# para Production e Preview.
CIME_SESSION_SECRET=

# Google OAuth 2.0 (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8770/oauth/google/callback

# SMTP para convites por e-mail (opcional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=1

# Smart Vision com IA (opcional; sem a chave o sistema usa OCR local).
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.6-sol
OPENAI_RESEARCH_MODEL=gpt-5.6-sol

# Fontes adicionais de metadados (opcionais).
TMDB_ACCESS_TOKEN=

# Banco persistente Neon/PostgreSQL usado pela Vercel. Configure como variável Sensitive.
# O backend aceita POSTGRES_URL_NON_POOLING, DATABASE_URL_UNPOOLED, POSTGRES_URL ou DATABASE_URL.
POSTGRES_URL_NON_POOLING=

# Caminho do executável Tesseract quando não estiver no PATH (opcional).
TESSERACT_CMD=
