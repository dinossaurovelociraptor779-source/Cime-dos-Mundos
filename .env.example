# Local defaults
CIME_PORT=8790
CIME_BIND=0.0.0.0
CIME_DATA_DIR=CimeDados
CIME_DEPLOYMENT=local
CIME_PERSISTENT_STORE=0
CIME_PUBLIC_URL=

# Persistent PostgreSQL (required on Vercel; required on Render when enabled)
# Set exactly one secret connection URL. Prefer CIME_DATABASE_URL for an explicit override.
CIME_DATABASE_URL=
SUPABASE_DB_URL=
SUPABASE_DATABASE_URL=
POSTGRES_URL_NON_POOLING=
DATABASE_URL_UNPOOLED=
POSTGRES_URL=
DATABASE_URL=

# Session signing secret (generate a unique random value; never commit the real value)
CIME_SESSION_SECRET=

# Google OAuth 2.0 web application
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8790/oauth/google/callback

# Gemini Smart Vision (server-side; optional)
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.8-flash

# OpenAI integrations (optional; server-side)
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.6-sol
OPENAI_RESEARCH_MODEL=gpt-5.6-sol
TMDB_ACCESS_TOKEN=

# SMTP invitations (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=1
