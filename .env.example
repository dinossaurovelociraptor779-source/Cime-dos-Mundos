# Copie este arquivo para .env e preencha apenas no ambiente local.
CIME_PORT=8770

# Segredo usado para assinar sessões e validar o estado OAuth.
# Gere um valor aleatório com pelo menos 64 caracteres.
# Nunca coloque o valor real neste arquivo versionado ou no GitHub.
# Na Vercel, configure CIME_SESSION_SECRET como variável Sensitive separada
# para Production e Preview.
CIME_SESSION_SECRET=

# Google OAuth 2.0 (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8770/oauth/google/callback

# SMTP para convites por e-mail (opcional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=1

# IA visual do Cime (Gemini API; mantenha a chave apenas no .env local/Vercel Secret)
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.8-flash

# OpenAI opcional: fallback visual e pesquisa web
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-6.1-terra
OPENAI_RESEARCH_MODEL=gpt-6.1-sol
